{
	"name": "nuntius-feed",
	"version": "0.6.0",
	"private": true,
	"description": "A lightweight web application for subscribing to and reading RSS and Atom feeds.",
	"license": "MIT",
	"author": "Witold Zawada (PoProstuWitold)",
	"homepage": "https://github.com/PoProstuWitold/nuntius-feed",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PoProstuWitold/nuntius-feed.git"
	},
	"bugs": {
		"url": "https://github.com/PoProstuWitold/nuntius-feed/issues"
	},
	"keywords": [
		"rss",
		"atom",
		"feed-reader",
		"aggregator",
		"self-hosted",
		"nextjs",
		"hono",
		"typescript",
		"mongodb",
		"jwt",
		"docker"
	],
	"engines": {
		"node": ">=24 <25"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.24.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": ">=24 <25"
		}
	},
	"scripts": {
		"dev": "next dev --port 3006 --turbopack",
		"build": "next build",
		"start": "next start --port 3006",
		"check": "biome check --write --unsafe",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/standard-validator": "^0.4.0",
		"@hono/zod-validator": "^0.9.0",
		"@rowanmanning/feed-parser": "^2.1.4",
		"@scalar/hono-api-reference": "^0.12.0",
		"argon2": "^0.45.1",
		"cheerio": "^1.2.0",
		"cron": "^4.4.0",
		"hono": "^4.13.5",
		"hono-openapi": "^1.3.1",
		"jose": "^6.2.10",
		"lucide-react": "^1.37.0",
		"mongoose": "^9.9.4",
		"nanoid": "^6.0.1",
		"next": "16.3.3",
		"p-limit": "^7.3.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "^7.86.0",
		"react-toastify": "^11.1.0",
		"rss-parser": "^3.13.0",
		"zod": "^4.5.4",
		"zod-openapi": "^6.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"autoprefixer": "^10.5.4",
		"daisyui": "^5.7.22",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
